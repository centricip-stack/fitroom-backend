# RunPod GPU Configuration
# Use 'cuda' for GPU, 'cpu' for CPU, or empty/None for auto-detect

# Device: cuda for RTX 4090, cpu for local dev
TRYON_DEVICE=cuda

# Memory management - prevent GPU overflow
PYTORCH_CACHE_DIR=/tmp/torch_cache
HF_HOME=/tmp/hf_cache

# Limit GPU memory growth (prevents OOM)
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Logging
LOG_LEVEL=INFO
